# Leftover .NET/WPF build output (pre-Rust-rebuild era, no longer produced)
bin/
obj/

# IDE / editor state
.vs/
.vscode/
.idea/
*.suo
*.user

# Local databases and SQLite sidecar files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Logs, crash dumps, and temporary files
*.log
*.dmp
*.dump
*.mdmp
*.tmp
*.temp
*.bak
*.old
*.orig
*.cache
*.crash
~$*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.snk

# Portable release packaging output (built locally, not part of source)
*.exe
*.zip
/dist/
