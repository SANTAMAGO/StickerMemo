<Window x:Class="StickerMemo.Views.FloatingNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickerMemo.Views"
        mc:Ignorable="d"
        Title="StickerMemo"
        Width="350" Height="350"
        MinHeight="180" MinWidth="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Flat Minimal Button Style -->
        <Style x:Key="FloatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Resize Grip Thumb Style -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent" Width="18" Height="18">
                            <Path Data="M 14,4 L 14,14 L 4,14 Z" Fill="#50000000" Stretch="Fill" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Round Button Style -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warm Paper ComboBox Style -->
        <Style x:Key="PaperComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="BorderBrush" Value="#25000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <!-- Root Grid with DropShadow margins -->
    <Grid Margin="16">
        <Border x:Name="PaperBorder" CornerRadius="8" Background="#FFF9C4" BorderBrush="#FDE047" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="7" Direction="270" Color="#000000" Opacity="0.28"/>
            </Border.Effect>

            <Grid Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Masking Tape & Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- Title Input -->
                    <RowDefinition Height="*"/>    <!-- Text Editor -->
                    <RowDefinition Height="Auto"/> <!-- Footer / UpdatedAt / Resize grip -->
                </Grid.RowDefinitions>

                <!-- Top Bar: Masking Tape & Toolbar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                    <!-- Right Control Toolbar (Declared first for right-side anchoring & no clipping) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Font Options Button -->
                        <Button x:Name="FontMenuButton" Style="{StaticResource FloatIconButtonStyle}" ToolTip="글꼴 및 텍스트 서식 (Font)" Click="OnFontMenuClick" Width="24" Height="24" Margin="2,0">
                            <TextBlock Text="🔤" FontSize="11"/>
                        </Button>

                        <!-- Color Palette Button -->
                        <Button x:Name="ColorPaletteButton" Style="{StaticResource FloatIconButtonStyle}" ToolTip="테마 색상 변경" Click="OnColorPaletteClick" Width="24" Height="24" Margin="2,0">
                            <TextBlock Text="🎨" FontSize="11"/>
                        </Button>

                        <!-- Archive Button -->
                        <Button Style="{StaticResource FloatIconButtonStyle}" ToolTip="보관함으로 이동 (Archive)" Click="OnArchiveClick" Width="24" Height="24" Margin="2,0">
                            <TextBlock Text="📦" FontSize="11"/>
                        </Button>

                        <!-- Delete Button -->
                        <Button Style="{StaticResource FloatIconButtonStyle}" ToolTip="메모 영구 삭제" Click="OnDeleteClick" Width="24" Height="24" Margin="2,0">
                            <TextBlock Text="🗑️" FontSize="11" Foreground="#990000"/>
                        </Button>

                        <!-- Close / Dock Back Button -->
                        <Button Style="{StaticResource FloatIconButtonStyle}" ToolTip="닫기 및 Deck으로 복귀 (✕)" Click="OnCloseDockBackClick" Width="24" Height="24" Margin="4,0,0,0">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#66000000"/>
                        </Button>
                    </StackPanel>

                    <!-- Top Masking Tape Badge -->
                    <Border HorizontalAlignment="Left" Background="#99FFFFFF" CornerRadius="2" Padding="8,2" BorderBrush="#20000000" BorderThickness="1" MaxWidth="90">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-0.6"/>
                        </Border.RenderTransform>
                        <TextBlock x:Name="TapeThemeLabel" Text="STICKER NOTE" FontSize="9" FontWeight="Bold" Foreground="#854D0E" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DockPanel>

                <!-- Color Palette Popup -->
                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorPaletteButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#F5FFFFFF" CornerRadius="16" Padding="6" Margin="4" BorderBrush="#25000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.18"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Button Width="22" Height="22" Margin="2" Background="#FEF08A" BorderBrush="#80000000" BorderThickness="1" Tag="Yellow" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Yellow">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Width="22" Height="22" Margin="2" Background="#FBCFE8" BorderBrush="#80000000" BorderThickness="1" Tag="Pink" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Pink">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Width="22" Height="22" Margin="2" Background="#A7F3D0" BorderBrush="#80000000" BorderThickness="1" Tag="Mint" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Mint">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Width="22" Height="22" Margin="2" Background="#BAE6FD" BorderBrush="#80000000" BorderThickness="1" Tag="Blue" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Blue">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Width="22" Height="22" Margin="2" Background="#DDD6FE" BorderBrush="#80000000" BorderThickness="1" Tag="Purple" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Purple">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Width="22" Height="22" Margin="2" Background="#E6D5B8" BorderBrush="#80000000" BorderThickness="1" Tag="Kraft" Click="OnSelectThemeClick" Cursor="Hand" ToolTip="Kraft">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Redesigned Sticky Note Paper Card Font Popup -->
                <Popup x:Name="FontPopup" PlacementTarget="{Binding ElementName=FontMenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#FAFAF7" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#35000000" BorderThickness="1" Width="230">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.22"/>
                        </Border.Effect>

                        <StackPanel Orientation="Vertical">
                            <!-- Mini Header Badge -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Aa" FontSize="11" FontWeight="Bold" Foreground="#854D0E" Margin="0,0,4,0"/>
                                    <TextBlock Text="서식" FontSize="10.5" FontWeight="SemiBold" Foreground="#555555"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 1. Font Family Dropdown with WYSIWYG Font Previews -->
                            <Border Background="#0D000000" CornerRadius="6" Padding="2" Margin="0,0,0,8">
                                <ComboBox x:Name="FontFamilyComboBox"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="12"
                                          SelectionChanged="OnFontFamilySelectionChanged"
                                          MaxDropDownHeight="180">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12.5" Padding="2" Foreground="#2A2A2A"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <!-- 2. Font Size Stepper & Bold Toggle Chip Row -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stepper UI: [ - ]  13.5 pt  [ + ] -->
                                <Border Grid.Column="0" Background="#0D000000" CornerRadius="12" Padding="3,2" Margin="0,0,8,0">
                                    <DockPanel LastChildFill="True">
                                        <!-- Minus Button -->
                                        <Button DockPanel.Dock="Left" Style="{StaticResource StepperButtonStyle}" ToolTip="글자 크기 축소" Click="OnDecreaseFontSizeClick">
                                            <TextBlock Text="−" FontSize="12" FontWeight="Bold" Foreground="#444444"/>
                                        </Button>

                                        <!-- Plus Button -->
                                        <Button DockPanel.Dock="Right" Style="{StaticResource StepperButtonStyle}" ToolTip="글자 크기 확대" Click="OnIncreaseFontSizeClick">
                                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#444444"/>
                                        </Button>

                                        <!-- Size Text -->
                                        <TextBlock x:Name="FontSizeDisplayText"
                                                   Text="13.5 pt"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Bold Toggle Chip -->
                                <Border x:Name="BoldChipBorder" Grid.Column="1" Background="#0D000000" CornerRadius="12" BorderBrush="#20000000" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnBoldChipClick" ToolTip="굵게 (Bold)">
                                    <StackPanel Orientation="Horizontal" Margin="8,3">
                                        <TextBlock Text="B" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,3,0"/>
                                        <TextBlock Text="굵게" FontSize="10.5" Foreground="#555555" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Title TextBox -->
                <TextBox x:Name="TitleTextBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         BorderBrush="#20000000"
                         Padding="2,4"
                         Margin="0,0,0,6"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="#262626"
                         TextChanged="OnTitleTextChanged"/>

                <!-- Content Text Editor -->
                <TextBox x:Name="ContentTextBox"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13.5"
                         Foreground="#2B2B2B"
                         TextChanged="OnContentTextChanged"/>

                <!-- Footer: Timestamp & Custom Resize Grip Thumb -->
                <DockPanel Grid.Row="3" Margin="2,6,0,0" LastChildFill="False">
                    <TextBlock x:Name="TimestampText"
                               DockPanel.Dock="Left"
                               FontSize="10"
                               Foreground="#66000000"
                               VerticalAlignment="Center"
                               Text="방금 수정됨"/>

                    <!-- Bottom Right WPF Resize Thumb -->
                    <Thumb DockPanel.Dock="Right"
                           Style="{StaticResource ResizeThumbStyle}"
                           Width="18" Height="18"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Right"
                           DragDelta="OnResizeThumbDragDelta"
                           DragCompleted="OnResizeThumbDragCompleted"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
