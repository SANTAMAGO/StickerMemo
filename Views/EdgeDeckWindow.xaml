<Window x:Class="StickerMemo.Views.EdgeDeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickerMemo.Views"
        mc:Ignorable="d"
        Title="StickerMemo"
        Width="460" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Flat Minimal Button Style -->
        <Style x:Key="DeckIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- New Note Round Floating Button Style -->
        <Style x:Key="NewNoteDeckButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="8,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#854D0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- More Notes Button Style -->
        <Style x:Key="MoreNotesButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0F2F2F2"/>
            <Setter Property="BorderBrush" Value="#30000000"/>
            <Setter Property="BorderThickness" Value="1,1,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,0,0,8" Padding="8,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="180" Opacity="0.12"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="SegmentedTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        
        <!-- ============================================================== -->
        <!-- POPUP: All Notes & Archive Drawer / Search Panel (Persistent)  -->
        <!-- ============================================================== -->
        <Grid x:Name="AllNotesContainer"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,150,0"
              Width="310" MaxHeight="500"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AllNotesTranslateTransform" X="30"/>
            </Grid.RenderTransform>

            <Border Background="#F9FAFB" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22"/>
                </Border.Effect>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Segmented Selector (Active | Archived) -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Notes List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Count -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="🗂️ 메모 서랍 (Drawer)" FontSize="12.5" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DeckIconButtonStyle}" ToolTip="닫기 (ESC)" Click="OnCloseAllNotesClick" Width="22" Height="22">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#6B7280"/>
                        </Button>
                    </DockPanel>

                    <!-- Segmented Selector: [ Active ] [ Archived ] -->
                    <Border Grid.Row="1" Background="#E5E7EB" CornerRadius="6" Padding="2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ActiveTabButton" Grid.Column="0" Style="{StaticResource SegmentedTabButtonStyle}" Click="OnActiveTabClick">
                                <TextBlock x:Name="ActiveTabLabel" Text="Active" FontSize="11" FontWeight="Bold" Foreground="#1F2937"/>
                            </Button>

                            <Button x:Name="ArchivedTabButton" Grid.Column="1" Style="{StaticResource SegmentedTabButtonStyle}" Click="OnArchivedTabClick">
                                <TextBlock x:Name="ArchivedTabLabel" Text="Archived" FontSize="11" FontWeight="Medium" Foreground="#6B7280"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search Box -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                            <TextBox x:Name="AllNotesSearchTextBox" Background="Transparent" BorderThickness="0" FontSize="12" FontFamily="Pretendard, Segoe UI" TextChanged="OnAllNotesSearchTextChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Notes List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <StackPanel x:Name="AllNotesListStackPanel" Orientation="Vertical"/>
                    </ScrollViewer>

                    <!-- Footer -->
                    <TextBlock x:Name="AllNotesFooterText" Grid.Row="4" Margin="0,6,0,0" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right" Text="총 0개의 메모"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- RIGHT: Note Deck Tabs (Screen Right Edge)                      -->
        <!-- ============================================================== -->
        <Border x:Name="DeckEdgeContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                MouseEnter="OnDeckMouseEnter" 
                MouseLeave="OnDeckMouseLeave">

            <StackPanel x:Name="TabsStackPanel" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,10,0,10">
                <!-- Dynamically generated NoteTab items will be added here -->
                
                <!-- Add New Note Button at bottom of Deck -->
                <Button x:Name="AddNewNoteDeckButton"
                        Style="{StaticResource NewNoteDeckButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        ToolTip="새 메모 추가 (+)"
                        Click="OnAddNewNoteClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="➕" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock x:Name="AddNewNoteLabel" Text="새 메모" FontSize="11" FontWeight="Medium" Foreground="#333333"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
